generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model League {
  id         String   @id @default(cuid())
  externalId String?  @unique
  name       String
  country    String
  logoUrl    String?
  matches    Match[]
  teams      Team[]
}

model Team {
  id          String   @id @default(cuid())
  externalId  String   @unique
  name        String
  logoUrl     String?
  leagueId    String
  league      League   @relation(fields: [leagueId], references: [id])
  homeMatches Match[]  @relation("HomeTeamMatches")
  awayMatches Match[]  @relation("AwayTeamMatches")
}

model Match {
  id          String      @id @default(cuid())
  externalId  String      @unique
  date        DateTime
  status      MatchStatus @default(SCHEDULED)
  leagueId    String
  league      League      @relation(fields: [leagueId], references: [id])
  
  homeTeamId  String
  homeTeam    Team        @relation("HomeTeamMatches", fields: [homeTeamId], references: [id])
  
  awayTeamId  String
  awayTeam    Team        @relation("AwayTeamMatches", fields: [awayTeamId], references: [id])
  
  homeScore   Int?
  awayScore   Int?
  prediction  Prediction?
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
}

model Prediction {
  id          String     @id @default(cuid())
  matchId     String     @unique
  match       Match      @relation(fields: [matchId], references: [id])
  probHomeWin Float
  probDraw    Float
  probAwayWin Float
  confidence  Confidence @default(MOYENNE)
  signal      Signal     @default(AUCUN)
  isPremium   Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

enum Confidence {
  FAIBLE
  MOYENNE
  HAUTE
}

enum Signal {
  AUCUN
  SIGNAL_FAIBLE
  SIGNAL_FORT
  TOP_PICK
}
