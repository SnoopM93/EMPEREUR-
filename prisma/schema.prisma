datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }
model League { id String @id @default(cuid()); externalId String @unique; name String; country String; logoUrl String? }
model Team { id String @id @default(cuid()); externalId String @unique; name String; logoUrl String?; leagueId String? }
model Match { id String @id @default(cuid()); externalId String @unique; date DateTime; status String; leagueId String; homeTeamId String; awayTeamId String; homeScore Int?; awayScore Int? }
